rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Elke vriezer ("huishouden") staat onder een lange, willekeurige code.
    // Alleen wie de code (deel-link) kent, kan de gegevens lezen/schrijven.
    match /households/{hid}/{collection}/{docId} {
      allow read, write: if request.auth != null
                         && hid.size() >= 16
                         && collection in ['items', 'log'];
    }
  }
}
